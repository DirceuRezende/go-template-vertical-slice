DATABASE_URL=postgres://postgres:postgres@localhost:5432/users?sslmode=disable
# gere com: openssl rand -base64 48
PASSWORD_PEPPER=
# segredo de assinatura dos access tokens (≥ 32 chars); gere com: openssl rand -base64 48
JWT_SECRET=
# durações no formato do Go (opcionais; padrões: 15m e 168h)
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
# admin inicial (opcional, ambos juntos): criado/promovido no startup, sem trocar a senha de um usuário existente
ADMIN_EMAIL=
ADMIN_PASSWORD=
PORT=8080
